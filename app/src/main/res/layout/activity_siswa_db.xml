<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SiswaDashB"
    android:background="@color/background">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:id="@+id/Dsb_PP"
        android:src="@drawable/boy"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="30dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinsmedium"
        android:text="Nama Siswa"
        android:textColor="@color/black"
        android:layout_marginTop="100dp"
        android:textSize="22sp"
        android:layout_centerHorizontal="true"
        android:id="@+id/Dsb_Nama"
        android:layout_toRightOf="@+id/Dsb_PP"
        android:layout_marginLeft="6dp"
        android:padding="5dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinsmedium"
        android:text="Kelas"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"
        android:textSize="22sp"
        android:layout_centerHorizontal="true"
        android:id="@+id/Dsb_Kelas"
        android:layout_toRightOf="@+id/Dsb_PP"
        android:layout_marginLeft="6dp"
        android:layout_below="@+id/Dsb_Nama"
        android:padding="5dp"
        />

    <Button
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:id="@+id/Dsb_Button1"
        android:backgroundTint="@color/primaryColor"
        android:layout_below="@+id/Dsb_Kelas"
        android:text="Quiz"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="150dp"
        android:layout_centerHorizontal="true"
        />

    <Button
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:backgroundTint="@color/primaryColor"
        android:text="History"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/Dsb_Button1"
        />

</RelativeLayout>


