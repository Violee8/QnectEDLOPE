<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SiswaScoreQ"
    android:background="@color/background"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Congratulation !"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="28dp"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true"
        android:padding="10dp"
        android:layout_marginTop="50dp"
        android:id="@+id/Score_C"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kamu menyelesaikan Quiz"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true"
        android:padding="10dp"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/Score_C"
        android:id="@+id/Score_K"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score : "
        android:fontFamily="@font/poppinssemibold"
        android:textSize="28dp"
        android:textColor="@color/black"
        android:layout_marginTop="55dp"
        android:layout_below="@+id/Score_K"
        android:id="@+id/Score_S"
        android:layout_marginLeft="130dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/Score_S"
        android:text="123"
        android:layout_below="@id/Score_K"
        android:layout_marginTop="58dp"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="26dp"
        android:textColor="@color/black"
        />

    <ImageButton
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/softOrange"
        android:src="@drawable/home"
        android:layout_marginTop="75dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/Score_S"
        android:background="@drawable/shape_home"
        />
</RelativeLayout>