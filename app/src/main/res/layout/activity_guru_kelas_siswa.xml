<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GuruKelasS"
    android:background="@color/background"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kelas Siswa"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="28dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:textColor="@color/black"
        android:id="@+id/kelas_txt"
        />

    <Button
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:id="@+id/kelas_Button1"
        android:backgroundTint="@color/primaryColor"
        android:layout_below="@+id/kelas_txt"
        android:text="Kelas 6A"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="70dp"
        android:layout_centerHorizontal="true"
        />

    <Button
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:id="@+id/kelas_Button2"
        android:backgroundTint="@color/primaryColor"
        android:layout_below="@+id/kelas_Button1"
        android:text="Kelas 6B"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"
        />

    <Button
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:id="@+id/kelas_Button3"
        android:backgroundTint="@color/primaryColor"
        android:layout_below="@+id/kelas_Button2"
        android:text="Kelas 5"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"
        />

</RelativeLayout>